# iPlayarr integration test environment.
# Copy to .env.integration and fill in the services you want to test against.
# Run with: npm run test:integration
# Tests for a service are skipped when its URL/API key are not set.
# Integration tests are excluded from `npm test`.

# Sonarr -> Settings -> General -> API Key
SONARR_URL=http://localhost:8989
SONARR_API_KEY=

# Radarr -> Settings -> General -> API Key
RADARR_URL=http://localhost:7878
RADARR_API_KEY=

# SABnzbd -> Config -> General -> API Key
SABNZBD_URL=http://localhost:8080
SABNZBD_API_KEY=

# NZBHydra2 -> Config -> Main -> API Key
NZBHYDRA2_URL=http://localhost:5076
NZBHYDRA2_API_KEY=

# iPlayarr -> Settings -> API Key
IPLAYARR_URL=http://localhost:4404
IPLAYARR_API_KEY=

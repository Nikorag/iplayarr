# iPlayarr Integration Test Environment
# Copy to .env.integration and fill in the values.
# Run with: make test integration

# ── Sonarr ────────────────────────────────────────────────────────────────────
# Find the API key at: Sonarr → Settings → General → API Key
SONARR_URL=http://192.168.107.92:8093
SONARR_API_KEY=

# ── Radarr ────────────────────────────────────────────────────────────────────
# Find the API key at: Radarr → Settings → General → API Key
RADARR_URL=http://192.168.107.83:7878
RADARR_API_KEY=

# ── SABnzbd ───────────────────────────────────────────────────────────────────
# SABnzbd is only reachable from the vlan107 network.
# Use: make test integration-sabnzbd  (runs tests inside the iplayarr container)
SABNZBD_URL=http://192.168.107.40:8092
SABNZBD_API_KEY=

# ── NZBHydra2 ─────────────────────────────────────────────────────────────────
# Find the API key at: NZBHydra2 → Config → Main → API Key
NZBHYDRA2_URL=http://192.168.107.30:5076
NZBHYDRA2_API_KEY=

# ── iPlayarr ──────────────────────────────────────────────────────────────────
# Find the API key at: iPlayarr → Settings → API Key
IPLAYARR_URL=http://192.168.107.127:4404
IPLAYARR_API_KEY=
